# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web.
# Single-line JSON string (the web config object). Not a secret, but kept out of git.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Base URL of the `api` Cloud Function (frontend-integration.md §2.2).
# Emulator:  http://127.0.0.1:5001/<project-id>/us-central1/api
# Deployed:  https://us-central1-<project-id>.cloudfunctions.net/api
VITE_API_BASE=http://127.0.0.1:5001/highlevel-assignment-20de2/us-central1/api

# 'true' routes Auth (9099), Firestore (8080) and Functions (5001) through the
# local Firebase emulators. Remove or set to anything else for production.
VITE_USE_EMULATORS=true

# Mock LLM flag: if 'true', use seed files instead of real LLM generation.
# Set to 'false' to use real Anthropic API calls via the backend.
VITE_MOCK_LLM=false

# HighLevel install URL (OAuth authorize page), opened in a new tab by the
# "Connect HighLevel" button (marketplace.gohighlevel.com/docs/Authorization/OAuth2.0).
# The redirect_uri must exactly match the callback registered in the marketplace app:
#   http://localhost:5173/oauth/callback   (dev)
# VITE_INSTALLATION_URL=https://marketplace.gohighlevel.com/oauth/chooselocation?response_type=code&redirect_uri=http://localhost:5173/oauth/callback&client_id=<client_id>&scope=<scopes>
